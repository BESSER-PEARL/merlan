IMAGE_ENTITIES

    person
        - description: "a human being"
        - weight: 70.5
        - color: "white"
    dog
    phone
        - description: "a human being"
    bottle

IMAGE_PROPERTIES

    indoors
        - description: "The picture is taken in an indoor environment (i.e., not outdoors)"
    iphone
        - description: "The phone in the image (if there is one) is an iPhone (Apple)"

SCENARIOS
    scenario1
        AND
            IMAGE_PROPERTY
                - image_property: iphone
                - name: "iphone"
                - score: 0.5
            IMAGE_ENTITY [2..*]
                - image_entity: person
                - name: "person"
                - score: 0.3
            IMAGE_ENTITY
                - image_entity: phone
                - name: "phone"
                - score: 0.5
