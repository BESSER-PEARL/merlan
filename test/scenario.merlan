ENTITIES:
  CONCRETE:
    person
      - gender: ?
      - ethnicity: ?
    smoke
    fire
    dog
      - breed: "labrador"
    car
      - brand: ?
      - model: ?
      - color: ?
  ABSTRACT:
    night
      - description: "The image is taken at night"
    empty_house
      - description: "The house is empty"
REQUIREMENTS:
  requirement1:
    CONCRETE IMAGE
      - entity: smoke
      - name: "smoke"
      - confidence: 0.5
  requirement2
    OR
      CONCRETE IMAGE
      - entity: fire
      - name: "fire"
      - confidence: 0.5
      AND
        ABSTRACT IMAGE
          - entity: empty_house
          - name: "empty_house"
          - confidence: 0.3
        OR
          CONCRETE IMAGE [1..*]
            - entity: person
            - name: "man"
            - confidence: 0.7
            - gender: "male"
          CONCRETE IMAGE [1..*]
            - entity: car
            - name: "unknown_car"
            - confidence: 0.7
